{
  "apiVersion": 1,
  "activationScope": "global",
  "id": "modera.interaction",
  "name": "User Interaction",
  "version": "0.1.1",
  "description": "需要澄清或手动操作时，在对话中收集用户的选择与回答。",
  "author": "Modera",
  "category": "interaction",
  "icon": "message",
  "main": "dist/index.cjs",
  "hostRenderers": {
    "question-result": {
      "entry": "question-result.js",
      "root": "dist/ui"
    },
    "plan-approval": {
      "entry": "plan-approval.js",
      "root": "dist/ui"
    }
  },
  "permissions": [
    "notifications.show"
  ],
  "extensions": [
    "tool.result"
  ],
  "agentGuidance": "When ask_user_question is available, use it whenever you need to ask the user for information. Collect the answer through the tool rather than ending with a plain-text question. Do not ask unnecessary questions when the request is already clear. Group related questions into one call using questions. Use free text by omitting options for open-ended questions; do not invent choices just to use the tool. Support single choice, multiple choice and optional skips. Wait for the real user response; do not poll or treat skipping or cancellation as consent. If ask_user_question is unavailable, ask in plain text. This guidance does not replace explicit plan or operation approval requirements.",
  "tools": [
    {
      "id": "approve_plan",
      "title": "计划审批",
      "description": "Submit a complete Markdown plan for explicit user approval before implementation. Call once after research and clarification. The tool waits for the user's decision. Only an explicit approval permits implementation; keep planning means revise the plan without changing files.",
      "executionKind": "interaction",
      "requiredPermissions": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": [
          "plan"
        ]
      },
      "presentation": {
        "icon": "message",
        "kind": "question",
        "tone": "violet",
        "targets": [
          "plan"
        ]
      }
    },
    {
      "id": "ask_user_question",
      "description": "Ask one question or up to 12 related questions in one call. Always provide questions: [{id,title,options:[{id,title,description}],multiSelect,allowOther,skippable,freeText,freeTextPlaceholder,freeTextMultiline,otherPlaceholder,nextLabel,layout,chipPosition}]. Omitted options means free text. allowOther and skippable default true. layout: inline/stacked; chipPosition: left/right. The user navigates questions and submits all answers together. Returns responses with questionId, selectedIds, selectedOptions, otherText and skipped. A single question also uses a one-element questions array. Wait for the real response without polling. Skipping/cancellation is not consent or operation approval. Maximum wait 30 minutes.",
      "locales": {
        "en": {
          "title": "Ask the user"
        },
        "zh-CN": {
          "description": "一次询问一个或多个相关问题，支持单选、多选、选项说明、自由文字、补充回答及逐题跳过；统一提交真实用户回答，不轮询。"
        }
      },
      "executionKind": "interaction",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "options": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "title"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          }
                        }
                      }
                    ]
                  }
                },
                "multiSelect": {
                  "type": "boolean"
                },
                "allowOther": {
                  "type": "boolean"
                },
                "skippable": {
                  "type": "boolean"
                },
                "freeText": {
                  "type": "boolean"
                },
                "freeTextMultiline": {
                  "type": "boolean"
                },
                "otherPlaceholder": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "freeTextPlaceholder": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "nextLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "layout": {
                  "enum": [
                    "inline",
                    "stacked"
                  ]
                },
                "chipPosition": {
                  "enum": [
                    "left",
                    "right"
                  ]
                }
              }
            }
          }
        },
        "type": "object",
        "required": [
          "questions"
        ]
      },
      "presentation": {
        "icon": "message",
        "kind": "question",
        "metrics": [
          {
            "format": "count",
            "label": "项回答",
            "labelEn": "answers",
            "path": "answers"
          }
        ],
        "targets": [
          "question"
        ],
        "tone": "violet"
      },
      "requiredPermissions": [],
      "title": "询问用户"
    }
  ],
  "locales": {
    "en": {
      "description": "Collect choices and answers when clarification or manual action is needed."
    },
    "zh-CN": {
      "name": "用户交互"
    }
  }
}
